#!/usr/bin/env bash
# reconcile-managed — reconcile every app-managed config file on this machine.
#
# This is YOUR list. Add one `merge-managed-json` line per app-managed JSON file.
# Called by bootstrap.sh (install time) and by the dotfiles-apply-hook in
# shell/.zshrc (on `dotfiles-apply`), so editing here is the single place that keeps
# every machine reconciled.
#
# The engine (merge-managed-json / capture-managed-json) ships with the
# dotfiles-update plugin, which bootstrap.sh installs — it isn't vendored here.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"

# The plugin's bundled tools (an interactive shell already has them on PATH; add
# them explicitly so bootstrap's non-interactive run does too).
PLUGIN_BIN="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/dotfiles-update/bin"
[ -d "$PLUGIN_BIN" ] && PATH="$PLUGIN_BIN:$PATH"

# --- your app-managed files -------------------------------------------------
# Uncomment / add lines. Nothing is reconciled by default.
#
# Claude Code — track shared plugins/theme, keep the per-machine `model` out of git:
#   merge-managed-json "$DOTFILES/claude/settings.base.json" \
#                      "$HOME/.claude/settings.json" model
#   # after enabling a plugin in-app, promote it back into the base:
#   capture-managed-json "$DOTFILES/claude/settings.base.json" \
#                        "$HOME/.claude/settings.json" model
#
# (Delete this file, the apply-hook in shell/.zshrc, and the reconcile step in
#  bootstrap.sh if you don't manage any app-owned config.)

:  # no-op so the script succeeds with an empty list
